      "kind": "bbox_extent",
      "target": {"part": "body"},
      "axis": "x",
      "unit": "mm",
      "criterion": {"equals": 20, "absolute_tolerance": 0.001}
    },
    {
      "id": "body.volume",
      "kind": "volume",
      "target": {"part": "body"},
      "unit": "mm^3",
      "criterion": {"equals": 6283.185307179586, "absolute_tolerance": 0.001}
    }
  ]
