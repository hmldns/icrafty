{
  "name": "crafty-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4187 --strictPort",
    "test": "PLAYWRIGHT_BROWSERS_PATH=./playwright/.cache playwright test",
    "test:server": "vite --host 127.0.0.1 --port 5287 --strictPort",
    "test:install": "PLAYWRIGHT_BROWSERS_PATH=./playwright/.cache playwright install chromium --only-shell"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
