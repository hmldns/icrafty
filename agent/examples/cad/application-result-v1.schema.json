                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^/api/agent/sessions/[^/]+/cad/artifacts/[^/?]+$"
                  },
                  "downloadUrl": {
                    "type": "string",
                    "pattern": "^/api/agent/sessions/[^/]+/cad/artifacts/[^/?]+\\?download=true$"
